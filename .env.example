# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
# Do NOT commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Spotify (REQUIRED) ───────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# In the app settings, add this exact Redirect URI: http://localhost:3000/callback
# Note: the Web Playback SDK requires a Spotify Premium account to stream.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# ── Translation (OPTIONAL) ───────────────────────────────────
# Leave this BLANK to use the free, no-key translator (default) — no credit card needed.
# Set it only if you want the official Google Cloud Translate API (higher reliability /
# rate limits). Key: https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_API_KEY=
